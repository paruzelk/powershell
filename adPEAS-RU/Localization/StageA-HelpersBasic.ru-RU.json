    "src/modules/Helpers/Ensure-LDAPConnection.ps1": {
      "Show-Line \"Aborting scan - LDAP session is no longer valid. Re-authenticate with Connect-adPEAS.\"": "Show-Line \"Аудит прерван: LDAP-сеанс больше не действителен. Подключитесь повторно с помощью Connect-adPEAS.\""
    },
    "src/modules/Helpers/Get-adPEASSession.ps1": {
